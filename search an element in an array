#include <stdio.h>

int main() {
    int n,i,search, found =0;
    printf("enter number of elements:\n");
    scanf("%d",&n);
    int arr[100];
    
    printf("enter %d elements",n);
    for(i = 0;i<n; i ++) {
    scanf("%d", &arr[i]);
    }
    printf("enter element to search");
    scanf("%d", &search);

    for(i = 0;i <n;i++){
    if ( arr[i]== search){
        found =1;
        printf("element %d found at position %d", search, i + 1);
        break;
    }
    }
    if ( found ==0){
    printf("number not found");
    return 0;
}
    }
    
