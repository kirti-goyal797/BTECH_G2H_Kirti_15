#include <stdio.h>

int main() {
    int rows, columns, i, j;
   
    int num,count=0;
    printf("Enter the number to find frequency:\n");
    printf("Enter the number of rows and columns: \n");
    scanf(" %d %d %d",&num ,&rows , &columns);
    int a [rows][columns];
    printf("enter the array:");
    for ( i = 0 ; i < rows ; i++){
    for (j=0; j<columns;j++){
        scanf("%d", &a[i][j]);
    }
    }
    for(i = 0 ; i< rows; i++){
        for(j=0; j< columns; j++){
            if(num ==a[i][j])
            {
               count ++;
            }
        }
    }
    
    printf("the sum of %d in matrix is %d", num , count);
    return 0;
 
}

    
    
