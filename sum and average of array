#include <stdio.h>

int main() {
    float s = 0.0 , avg;
    int n,i;
    printf("enter number of elements:\n");
    scanf("%d",&n);
    int arr[100];
    
    printf("enter %d elements",n);
    for(i = 0;i<n; i ++) {
    scanf("%d", &arr[i]);
    }
    for(i = 0;i <n;i++){
    s += arr[i];
    }
    avg = s/ n  ;
    printf("the sum is : %f", s);
    printf("the average is %f", avg);
    
    return 0;
}
