#include <stdio.h>

int main() {
   int n,i,j;
   printf("Enter size of sqaure:");
   scanf("%d",&n);
   for(i=1; i<=n; i ++) {
       for(j=1;j<=n;j++) {
           if(i ==1|i ==n |j ==1 | j==n){
               printf("*\t");}
           else{
               printf(" \t");
           }
       }
       printf("\n");
   }
   return 0;
 
