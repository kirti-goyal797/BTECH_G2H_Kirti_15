#include <stdio.h>
int main ()
{
    int i, n;
    int sum =0;
    printf("enter the size of an array:");
    scanf("%d",&n);
    int a[n];
    printf("enter array elements:");
    for(i=0;i<n; i++)
    {scanf("%d" ,&a[i]);}
    for(i=0;i<n; i++) 
    {
        sum = sum + a[i];
    }
    printf("sum of array elements is %d ", sum);
}
